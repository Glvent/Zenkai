{
  "name": "zenkai",
  "displayName": "Zenkai",
  "description": "A minimal Monokai Pro fork with five dark variants and one light variant.",
  "version": "1.0.6",
  "publisher": "glvent",
  "icon": "assets/zenkai.png",
  "author": "George Vent <gvent2007@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Glvent/Zenkai.git",
    "directory": "themes/vscode"
  },
  "main": "./dist/src/extension.js",
  "scripts": {
    "build": "jiti scripts/build.ts",
    "compile": "jiti scripts/build.ts compile",
    "test": "jiti scripts/build.ts test",
    "dev": "jiti scripts/build.ts dev",
    "generate": "jiti scripts/build.ts generate",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.tooling.json",
    "package": "npm test && npx --yes @vscode/vsce package --allow-missing-repository --skip-license --baseImagesUrl https://github.com/Glvent/Zenkai/raw/HEAD/themes/vscode/",
    "install:local": "npm run package && jiti scripts/build.ts install",
    "version:patch": "npm version patch --no-git-tag-version",
    "format": "prettier --write \"**/*.{ts,json,md}\" && prettier --config .prettierrc --write \"../../src/**/*.ts\""
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/vscode": "^1.60.0",
    "jiti": "^2.7.0",
    "prettier": "^3.4.2",
    "typescript": "^5.9.3"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "color-theme",
    "monokai",
    "dark",
    "light",
    "zenkai"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Zenkai Classic",
        "uiTheme": "vs-dark",
        "path": "./themes/zenkai-classic.json"
      },
      {
        "label": "Zenkai Espresso",
        "uiTheme": "vs-dark",
        "path": "./themes/zenkai-espresso.json"
      },
      {
        "label": "Zenkai Nautilus",
        "uiTheme": "vs-dark",
        "path": "./themes/zenkai-nautilus.json"
      },
      {
        "label": "Zenkai Graphite",
        "uiTheme": "vs-dark",
        "path": "./themes/zenkai-graphite.json"
      },
      {
        "label": "Zenkai Clay",
        "uiTheme": "vs-dark",
        "path": "./themes/zenkai-clay.json"
      },
      {
        "label": "Zenkai Paper",
        "uiTheme": "vs",
        "path": "./themes/zenkai-paper.json"
      }
    ],
    "configuration": {
      "title": "Zenkai",
      "type": "object",
      "properties": {
        "zenkai.popupTransparency": {
          "type": "number",
          "default": 1,
          "order": 1,
          "minimum": 0,
          "maximum": 1,
          "markdownDescription": "Adjust popup menu opacity from `0` to `1`."
        },
        "zenkai.terminalMatchLocation": {
          "type": "boolean",
          "default": false,
          "order": 2,
          "tags": [
            "experimental"
          ],
          "markdownDescription": "Match the terminal background to the panel or sidebar it is in. Requires VS Code 1.91+."
        },
        "zenkai.accent.graphite": {
          "type": "string",
          "default": "Default",
          "order": 3,
          "enum": [
            "Default",
            "Sand",
            "Copper",
            "Steel",
            "Sage"
          ],
          "enumDescriptions": [
            "#f0a84a",
            "#e6c88a",
            "#d98b5f",
            "#7fa7cf",
            "#a6bf8f"
          ],
          "markdownDescription": "Accent color for Zenkai Graphite. Changes interface highlights; syntax colors are unchanged."
        },
        "zenkai.accent.classic": {
          "type": "string",
          "default": "Default",
          "order": 4,
          "enum": [
            "Default",
            "Olive",
            "Khaki",
            "Rust",
            "Moss"
          ],
          "enumDescriptions": [
            "#ddb860",
            "#b5b86a",
            "#cdb98a",
            "#c97f56",
            "#8fae7a"
          ],
          "markdownDescription": "Accent color for Zenkai Classic. Changes interface highlights; syntax colors are unchanged."
        },
        "zenkai.accent.espresso": {
          "type": "string",
          "default": "Default",
          "order": 5,
          "enum": [
            "Default",
            "Caramel",
            "Cinnamon",
            "Latte",
            "Rosewood"
          ],
          "enumDescriptions": [
            "#c89878",
            "#d8a65c",
            "#c0784e",
            "#d6bfa0",
            "#c48f8f"
          ],
          "markdownDescription": "Accent color for Zenkai Espresso. Changes interface highlights; syntax colors are unchanged."
        },
        "zenkai.accent.nautilus": {
          "type": "string",
          "default": "Default",
          "order": 6,
          "enum": [
            "Default",
            "Teal",
            "Sky",
            "Seafoam",
            "Indigo"
          ],
          "enumDescriptions": [
            "#5278a0",
            "#4f9a9a",
            "#7ab0d8",
            "#7fb8a4",
            "#7b84c4"
          ],
          "markdownDescription": "Accent color for Zenkai Nautilus. Changes interface highlights; syntax colors are unchanged."
        },
        "zenkai.accent.clay": {
          "type": "string",
          "default": "Default",
          "order": 7,
          "enum": [
            "Default",
            "Kraft",
            "Crail",
            "Claude Blue",
            "Sage"
          ],
          "enumDescriptions": [
            "#d97757",
            "#d4a27f",
            "#c15f3c",
            "#6a9bcc",
            "#a3b18a"
          ],
          "markdownDescription": "Accent color for Zenkai Clay. Changes interface highlights; syntax colors are unchanged."
        },
        "zenkai.accent.paper": {
          "type": "string",
          "default": "Default",
          "order": 8,
          "enum": [
            "Default",
            "Rust",
            "Navy",
            "Forest",
            "Plum"
          ],
          "enumDescriptions": [
            "#8a5e10",
            "#a3471f",
            "#2f5d8a",
            "#3f6e3a",
            "#7a4a7e"
          ],
          "markdownDescription": "Accent color for Zenkai Paper. Changes interface highlights; syntax colors are unchanged."
        },
        "zenkai.accentCustomColor": {
          "type": "string",
          "default": "",
          "order": 9,
          "pattern": "^$|^#[0-9a-fA-F]{6}$",
          "patternErrorMessage": "Enter a color as #RRGGBB, or leave blank.",
          "markdownDescription": "Custom accent color as `#RRGGBB`. Overrides the accent preset for every Zenkai theme. Leave blank to use the presets. Changes interface highlights; syntax colors are unchanged."
        }
      }
    }
  }
}
