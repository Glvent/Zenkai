# Keep the packaged .vsix lean: ship only runtime files.
# Included by default: package.json, README.md, LICENSE,
# assets/zenkai.png, themes/zenkai-*.json, dist/src/**, dist/themes/**

# Source and development tooling
src/**
scripts/**
**/*.ts

# Tests (source and compiled)
test/**
.test-build/**

# Sourcemaps are not needed at runtime
dist/**/*.map

# Tooling / configs
tsconfig*.json
.gitignore
.gitattributes
.editorconfig
.prettierrc
.prettierignore
.npmrc
.vscode/**

# Package manager / scratch
node_modules/**
package-lock.json
**/*.vsix
theme-references/**
docs/**

# OS noise
.DS_Store
Thumbs.db
